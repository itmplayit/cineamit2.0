<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#88C4B5FD" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="21dp" />
            <gradient
                android:angle="0"
                android:endColor="#CC4C1D95"
                android:startColor="#CC7C3AED" />
        </shape>
    </item>
    <item
        android:height="12dp"
        android:gravity="top"
        android:left="10dp"
        android:right="10dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
