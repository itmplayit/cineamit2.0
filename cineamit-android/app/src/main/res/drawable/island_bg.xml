<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <stroke
                android:width="1.2dp"
                android:color="#AAC4B5FD" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="29dp" />
            <gradient
                android:angle="270"
                android:endColor="#F20A0612"
                android:startColor="#E61A1228" />
        </shape>
    </item>
    <item
        android:height="16dp"
        android:gravity="top"
        android:left="16dp"
        android:right="16dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#00C4B5FD"
                android:startColor="#28C4B5FD" />
        </shape>
    </item>
</layer-list>
