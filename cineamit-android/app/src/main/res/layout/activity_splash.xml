<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0612">

    <View
        android:id="@+id/splashGlow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:layout_marginBottom="36dp"
        android:alpha="0.7"
        android:background="@drawable/splash_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <FrameLayout
            android:layout_width="176dp"
            android:layout_height="176dp">

            <View
                android:id="@+id/splashRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/orbit_ring" />

            <ImageView
                android:id="@+id/splashLogo"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/cineamit_logo" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/custom"
            android:letterSpacing="0.34"
            android:text="CINEAMIT"
            android:textColor="#F4F1EA"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/splashTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/custom"
            android:letterSpacing="0.18"
            android:text="Movies  ·  Series  ·  Live TV"
            android:textAllCaps="true"
            android:textColor="#A78BFA"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/splashFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="48dp">

        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="4dp"
            android:background="@drawable/splash_bar_track">

            <View
                android:id="@+id/splashBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/splash_bar_fill"
                android:transformPivotX="0px" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/custom"
            android:letterSpacing="0.12"
            android:text="Loading your cinema"
            android:textColor="#88C4B5FD"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
