<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cineControls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <View
        android:id="@+id/ctrlScrimTop"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_gravity="top"
        android:background="@drawable/player_top_scrim" />

    <View
        android:id="@+id/ctrlScrimBot"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/player_bot_scrim" />

    <LinearLayout
        android:id="@+id/ctrlTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ctrlBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/player_chip"
            android:contentDescription="@string/app_name"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ctrlBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/player_chip"
                android:fontFamily="@font/custom"
                android:paddingStart="10dp"
                android:paddingTop="2dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp"
                android:text="OFFLINE"
                android:textColor="#C4B5FD"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ctrlTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/custom"
                android:maxLines="1"
                android:textColor="#F4F1EA"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/ctrlQuality"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Quality"
            android:textColor="#C4B5FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ctrlAudio"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Audio"
            android:textColor="#C4B5FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ctrlSub"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="CC"
            android:textColor="#C4B5FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ctrlSleep"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Sleep"
            android:textColor="#C4B5FD"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ctrlSpeed"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="1x"
            android:textColor="#C4B5FD"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ctrlLock"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_lock" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ctrlCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ctrlRew"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_replay_10" />

        <ImageView
            android:id="@+id/ctrlPlay"
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/player_play_ring"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="22dp"
            android:src="@drawable/ic_tr_play" />

        <ImageView
            android:id="@+id/ctrlFwd"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/player_chip"
            android:clickable="true"
            android:contentDescription="@string/app_name"
            android:focusable="true"
            android:padding="14dp"
            android:src="@drawable/ic_forward_10" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ctrlBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ctrlPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="00:00"
                android:textColor="#F4F1EA"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/ctrlSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:max="1000"
                android:progressDrawable="@drawable/player_seek_track"
                android:splitTrack="false"
                android:thumb="@drawable/player_seek_thumb" />

            <TextView
                android:id="@+id/ctrlDur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="00:00"
                android:textColor="#9C9C9C"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ctrlLiveHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/custom"
                android:text=""
                android:textColor="#80C4B5FD"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/ctrlMute"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/player_chip"
                android:clickable="true"
                android:contentDescription="@string/app_name"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/ic_volume" />

            <ImageView
                android:id="@+id/ctrlFs"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/player_chip"
                android:contentDescription="@string/app_name"
                android:padding="8dp"
                android:src="@drawable/ic_fullscreen" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ctrlSkipFlash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="90dp"
        android:background="@drawable/player_chip"
        android:fontFamily="@font/custom"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:textColor="#F4F1EA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ctrlUnlock"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="16dp"
        android:background="@drawable/player_play_ring"
        android:clickable="true"
        android:contentDescription="@string/app_name"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_lock"
        android:visibility="gone" />
</FrameLayout>
