<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/pin_dialog_bg"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/acc_icon_bg"
            android:contentDescription="@string/app_name"
            android:padding="12dp"
            android:src="@drawable/ic_lock"
            android:tint="#C4B5FD" />

        <TextView
            android:id="@+id/pinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/custom"
            android:text="Private PIN"
            android:textColor="#F4F1EA"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pinSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Enter 4-digit PIN"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/pinDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/pinDot1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/pin_dot" />

            <View
                android:id="@+id/pinDot2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/pin_dot" />

            <View
                android:id="@+id/pinDot3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/pin_dot" />

            <View
                android:id="@+id/pinDot4"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/pin_dot" />

            <View
                android:id="@+id/pinDot5"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/pin_dot"
                android:visibility="gone" />

            <View
                android:id="@+id/pinDot6"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/pin_dot"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/pinError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#F87171"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pinSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/gradient_btn"
            android:fontFamily="@font/custom"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="Send OTP"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/pinKeys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/pinKey1" style="@style/PinKey" android:text="1" />
                <TextView android:id="@+id/pinKey2" style="@style/PinKey" android:text="2" />
                <TextView android:id="@+id/pinKey3" style="@style/PinKey" android:text="3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/pinKey4" style="@style/PinKey" android:text="4" />
                <TextView android:id="@+id/pinKey5" style="@style/PinKey" android:text="5" />
                <TextView android:id="@+id/pinKey6" style="@style/PinKey" android:text="6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView android:id="@+id/pinKey7" style="@style/PinKey" android:text="7" />
                <TextView android:id="@+id/pinKey8" style="@style/PinKey" android:text="8" />
                <TextView android:id="@+id/pinKey9" style="@style/PinKey" android:text="9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/pinKeyBlank"
                    style="@style/PinKey"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:text="" />

                <TextView android:id="@+id/pinKey0" style="@style/PinKey" android:text="0" />

                <TextView
                    android:id="@+id/pinKeyDel"
                    style="@style/PinKey"
                    android:text="⌫"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/pinForgot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Forgot PIN?  Email OTP"
            android:textColor="#C4B5FD"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pinCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="Cancel"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
