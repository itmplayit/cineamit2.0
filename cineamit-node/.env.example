# CINEAMIT private server settings — Node >=22.12
 # Copy: cp .env.example .env; fill DB/API/secrets, then npm start.
# Existing env.js: use node tools/migrate-env.js instead (do not rotate SECRET_KEY).
# Dotenv data, NOT JavaScript: KEY=value; no module.exports/colons/trailing commas.
# Host/dashboard environment overrides .env, including empty values. No variable expansion.
# Quote values containing #, spaces or line breaks. Never commit/share .env.
# LOCAL below; production: set APP_PUBLIC_ORIGIN and OAUTH_BASE_URL to the real HTTPS host.
# SEO_PUBLIC_ORIGIN stays the actual public canonical HTTPS host.
PORT=3000
HOST=0.0.0.0

APP_DEBUG="false"
APP_PUBLIC_ORIGIN="http://localhost:3000"
# Search identity: set this to the ONE public canonical origin, including on mirror deployments.
SEO_PUBLIC_ORIGIN="https://cineamit.qzz.io"
GOOGLE_SITE_VERIFICATION=""
BING_SITE_VERIFICATION=""
INDEXNOW_KEY=""
# Daily IndexNow announcement of published sitemap URLs (Bing/Yandex etc.).
# Needs INDEXNOW_KEY + a public SEO_PUBLIC_ORIGIN; the proof file /indexnow-key.txt
# is served automatically. Submission announces URLs only — indexing/ranking is
# never guaranteed. Interval is hours (1-720, default 24).
INDEXNOW_AUTO="false"
INDEXNOW_AUTO_INTERVAL_HOURS="24"
# Daily Google Search Console sitemap submission (Webmasters API, service account).
# Add the service-account email as a property OWNER in Search Console first.
# GOOGLE_SITEMAPS_SITE = exact property: URL-prefix ending with / (https://example.com/)
# or domain property (sc-domain:example.com). GOOGLE_SITEMAPS_FEEDS = comma list of
# sitemap filenames on the site (default sitemap.xml).
GOOGLE_SITEMAP_AUTO="false"
GOOGLE_SA_JSON_FILE=""
GOOGLE_SITEMAPS_SITE=""
GOOGLE_SITEMAPS_FEEDS="sitemap.xml"
SECRET_KEY="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"

DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_NAME="cineamit"
DB_USER="cineamit"
DB_PASS="REPLACE_DB_PASSWORD"
DB_SSL="auto"
DB_SSL_CA_FILE=""
APP_ALLOW_TICKET_TABLE_REBUILD="false"

TMDB_API_KEY="REPLACE_TMDB_API_KEY"
# Keep false: certificate errors fail closed. True is an explicit insecure diagnostic opt-in only.
TMDB_INSECURE_TLS_RETRY="false"
TMDB_IMAGE_BASE_URL="https://image.tmdb.org/t/p/original"
TMDB_IMAGE_BASE="https://image.tmdb.org/t/p"

OWNER_BOOTSTRAP_KEY="REPLACE_WITH_32_PLUS_RANDOM_CHARS_FOR_FIRST_OWNER"
OAUTH_BASE_URL="http://localhost:3000"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
MAIL_FROM_NAME="CineAmit"
BREVO_API_KEY=""
RESEND_API_KEY=""
OTP_DEBUG="false"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

TRUST_PROXY_REAL_IP="false"
TRUSTED_PROXIES=""
# Direct Unity rewarded verification: obtain S2S enablement + secret from Unity Ads Support.
UNITY_S2S_ENABLED="false"
UNITY_S2S_SECRET=""
UNITY_GAME_ID="800377017"
UNITY_REWARDED_PLACEMENT="BP_Rewarded_Android"
VAST_ALLOWED_HOSTS=""
PAGE_CACHE_TTL="300"
WARM_KEY=""
BLOCK_BAD_BOTS="true"
ADS_ENABLED="true"
SPLASH_ENABLED="true"
CURSOR_ENABLED="true"
SETUP_ENABLED="false"

GA_MEASUREMENT_ID=""
# Android app GA4 (same property as the website). GA4 Admin → Data stream → Measurement Protocol API secrets.
GA_API_SECRET=""
ADSENSE_PUB_ID=""
HILLTOPADS_VAST_URL=""
VAST_FALLBACK_URL=""
ADSTERRA_SOCIAL_BAR=""
ADSTERRA_POPUNDER=""
ADSTERRA_BANNER_728=""
ADSTERRA_BANNER_300=""
ADSTERRA_BANNER_320=""
ADSTERRA_BANNER_468=""
ADSTERRA_BANNER_160=""
ADSTERRA_NATIVE_BANNER=""
ADSTERRA_SMARTLINK_URL=""

# Android Unity-only — set these in cineamit-android/gradle.properties (not here):
# UNITY_GAME_ID=your_android_game_id
# UNITY_BANNER_PLACEMENT=Banner_Android
# UNITY_INTERSTITIAL_PLACEMENT=Interstitial_Android
# UNITY_REWARDED_PLACEMENT=Rewarded_Android

STALKER_PORTAL_URL=""
STALKER_MAC=""
CLOUDFLARE_PROXY_URL=""
M3U_PLAYLISTS=""

